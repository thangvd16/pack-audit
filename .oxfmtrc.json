{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 160,
	"useTabs": true,
	"tabWidth": 4,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"semi": true,
	"trailingComma": "all",
	"sortPackageJson": false,
	"sortImports": false,
	"tailwind": {
		"enabled": true
	},
	"ignorePatterns": ["node_modules", "dist", "src-tauri/target", "src-tauri/gen", ".git"]
}
